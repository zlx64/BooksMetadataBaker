{
  "PdfLibrary": {
    "RootFolder": "/data/books",
    "ProcessingBatchSize": 4,
    "AniList": {
      "BaseUrl": "https://graphql.anilist.co"
    },
    "GoogleBooks": {
      "BaseUrl": "https://www.googleapis.com/books/v1/volumes",
      "ApiKey": "AIzaSyCMbb8dVr_bxTle3lXee1HWzgczWBIKcM8"
    },
    "ComicVine": {
      "BaseUrl": "https://comicvine.gamespot.com/api",
      "ApiKey": "COMIC_VINE_API_KEY_PLACEHOLDER"
    }
  },
  "Tools": {
    "SidecarMetadataEnabled": true,
    "GhostscriptEnabled": true,
    "GhostscriptPath": "gs"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "/data/books/logs/prepkavita.log", "rollingInterval": "Day", "retainedFileCountLimit": 7, "shared": true, "outputTemplate": "{Timestamp:O} {Level:u3} {SourceContext} {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*"
}
