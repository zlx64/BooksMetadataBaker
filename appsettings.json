{
  "PdfLibrary": {
    "RootFolder": "/data/books",
    "AniList": {
      "BaseUrl": "https://graphql.anilist.co"
    },
    "GoogleBooks": {
      "BaseUrl": "https://www.googleapis.com/books/v1/volumes",
      "ApiKey": ""
    },
    "ComicVine": {
      "BaseUrl": "https://comicvine.gamespot.com/api",
      "ApiKey": ""
    },
    "TypeFolders": {
      "Book": "Novel",
      "LightNovel": "Ranobe",
      "Manga": "Manga",
      "Comic": "Comics"
    }
  },
  "MangaComics": {
    "Enabled": true,
    "AllowedExtensions": "cbz,cbr,cb7,cbt,zip,rar,7z,tar",
    "SpecialsSubfolder": true,
    "UseCurlyBraceYear": false
  },
  "Tools": {
    "SidecarMetadataEnabled": true,
    "GhostscriptEnabled": true,
    "GhostscriptPath": "gs",
    "EbookMetaPath": "ebook-meta",
    "SevenZipPath": "7z",
    "RarPath": "",
    "SourceOrder": "AniList,GoogleBooks,ComicVine"
  },
  "Auth": {
    "ApiKey": ""
  },
  "RateLimiting": {
    "UploadPermitLimit": 10,
    "UploadWindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "/data/books/logs/baker-.log", "rollingInterval": "Day", "retainedFileCountLimit": 10, "shared": true, "outputTemplate": "{Timestamp:O} {Level:u3} {SourceContext} {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*"
}
